SERVICE_NAME=frontend_service
LOG_LEVEL=INFO
# Формат вывода логов: console (для docker compose logs) | json (для сборщиков Loki/ELK).
# Логи пишутся только в stdout: ротацию делает docker logging driver (x-logging в compose)
LOG_FORMAT=console

# Куда проксировать /api/* (локально; в docker-compose — http://agent_service:7860)
AGENT_SERVICE_URL=http://localhost:7860
# Порт веб-интерфейса (3000-3040 заняты другими сервисами)
FRONTEND_PORT=3050
