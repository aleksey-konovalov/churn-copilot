SERVICE_NAME=embedding_service
LOG_LEVEL=DEBUG
# Формат вывода логов: console (для docker compose logs) | json (для сборщиков Loki/ELK).
# Логи пишутся только в stdout: ротацию делает docker logging driver (x-logging в compose)
LOG_FORMAT=console

HF_TOKEN=

EMBEDDING_PORT=3020

# Варианты эмбеддера: frida | giga
EMBEDDER_TYPE=frida
MODEL_PATH=ai-forever/FRIDA
# DEVICE=cuda для тяжёлой Giga-модели; в compose переопределён на cpu (FRIDA лёгкая)
DEVICE=cuda
TOKENIZER_MAX_LENGTH=512
