SERVICE_NAME=agent_service
LOG_LEVEL=DEBUG
# Формат вывода логов: console (для docker compose logs) | json (для сборщиков Loki/ELK).
# Логи пишутся только в stdout: ротацию делает docker logging driver (x-logging в compose)
LOG_FORMAT=console

# Выбор активной модели для сервиса
ACTIVE_LLM_PROFILE=local_qwen_agent

# ENV-оверрайд base_url из llm_config.json для ВСЕХ профилей.
# Локально не задан (используется localhost:3040 из конфига); в docker-compose
# по умолчанию указывает на vLLM в сети compose (http://vllm:8901/v1) и берётся
# из .env корня репозитория: например, http://host.docker.internal:3040/v1 —
# vLLM, развёрнутый на хосте (host.docker.internal пробрасывается через extra_hosts)
#LLM_BASE_URL=

# Имя модели на LLM-сервере (SERVED_MODEL_NAME vLLM), если отличается от "model" в llm_config.json
#LLM_MODEL=

# API-ключи для LLM
OPENAI_API_KEY=

# --- URL зависимостей ---
# В docker-compose переопределяются именами сервисов compose-сети. Дефолты ниже —
# для локального запуска сервиса вручную (вне Makefile); порты churn_pred/embedding/qdrant
# на хост не публикуются (см. README), так что локально доступны только они сами по себе.
CHURN_PRED_SERVICE_URL=http://localhost:3010

# Выгрузка клиентов для экрана «Клиенты» (client_id = номер строки CSV).
# При старте сервиса CSV перегоняется в SQLite-БД ниже; при изменении файла — перегоняется заново.
CLIENTS_CSV_PATH=../data_science/data/raw/test.csv
# Файл SQLite с выгрузкой клиентов (создаётся автоматически)
CLIENTS_DB_PATH=clients.db

CHURN_PROB_THRESHOLD=0.5
COLLECTION_NAME=policies
QDRANT_SPACE_NAME=text_vector
DEFAULT_CHUNKS_LIMIT=5
MAX_TOTAL_CHUNKS=30
MIN_ABSOLUTE_SCORE=0.4
VOTE_BOOST=0.05

EMBEDDING_SERVICE_URL=http://localhost:3020

QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Контекст и память агента ---
# Порог суммаризации истории (в токенах). Должен быть заметно меньше MAX_MODEL_LEN vLLM:
# при MAX_MODEL_LEN=16384 — 10000, при 8192 — ~5000
SUMMARIZATION_TRIGGER_TOKENS=10000
# Сколько последних сообщений держать дословно при суммаризации
SUMMARIZATION_KEEP_MESSAGES=8
# Профиль LLM-суммаризатора из llm_config.json
SUMMARIZER_LLM_PROFILE=local_qwen_summarizer
# Профиль fallback-модели для ModelFallbackMiddleware (контур включается только при заданном API-ключе)
FALLBACK_LLM_PROFILE=summarizer
# Файл SQLite checkpointer'а — краткосрочная память диалогов (переживает рестарт сервиса)
CHECKPOINT_DB_PATH=checkpoints.db
