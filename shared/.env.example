# Конфигурация скачивания ассетов (make download-assets / restore-qdrant / save-snapshot).
# Скопируйте в shared/.env (gitignored) и подставьте свои Google Drive file ID.
# Файл читается скриптом shared/utils/download_project_assets.py и целью dev-tools в compose.

# Коллекция Qdrant (используется и Makefile, и путь сохранения снапшота)
QDRANT_COLLECTION=policies

# File ID модели CatBoost -> data_science/artifacts/best_model.cbm
GOOGLE_DRIVE_MODEL_ID=

# File ID train/val -> data_science/data/processed/
GOOGLE_DRIVE_TRAIN_ID=
GOOGLE_DRIVE_VAL_ID=

# File ID тестовой выгрузки -> data_science/data/raw/test.csv
GOOGLE_DRIVE_TEST_ID=

# File ID снапшота Qdrant -> infra/qdrant/snapshots/<QDRANT_COLLECTION>/snapshot.snapshot
GOOGLE_DRIVE_QDRANT_SNAPSHOT_ID=
